{{ 'main-blog-post.css' | asset_url | stylesheet_tag }}

<article class="custom-blog-post">

  <section class="custom-blog-post__hero">

    <div class="custom-blog-post__container">

      <nav
        class="custom-blog-post__breadcrumbs"
        aria-label="Breadcrumb"
      >
        <a href="{{ routes.root_url }}">
          Home
        </a>

        <span class="custom-blog-post__separator">
          ›
        </span>

        {% if blog %}
          <a href="{{ blog.url }}">
            {{ blog.title }}
          </a>
        {% else %}
          <span>
            Blog
          </span>
        {% endif %}

        <span class="custom-blog-post__separator">
          ›
        </span>

        <span class="custom-blog-post__current">
          {{ article.title }}
        </span>
      </nav>

      <div class="custom-blog-post__hero-grid">

        <div class="custom-blog-post__hero-content">

          <div class="custom-blog-post__title">
            {% content_for 'block',
              type: 'text',
              id: 'blog-post-title'
            %}
          </div>

          <div class="custom-blog-post__description">

            {% if article.excerpt != blank %}
              {{ article.excerpt }}
            {% else %}
              {% assign article_description = article.content
                | strip_html
                | truncatewords: 35
              %}

              {% if article_description != blank %}
                {{ article_description }}
              {% endif %}
            {% endif %}

          </div>

          <div class="custom-blog-post__details">
            {% content_for 'block',
              type: '_blog-post-info-text',
              id: 'blog-post-details'
            %}
          </div>

        </div>

        <div class="custom-blog-post__hero-image">

          {% if article.image != blank %}

            {{
              article.image
              | image_url: width: 1600
              | image_tag:
                class: 'custom-blog-post__image',
                widths: '600, 800, 1000, 1200, 1400, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'eager',
                alt: article.image.alt | default: article.title
            }}

          {% else %}

            <div class="custom-blog-post__image-placeholder"></div>

          {% endif %}

        </div>

      </div>

    </div>

  </section>


  <section class="custom-blog-post__content-section">

    <div class="custom-blog-post__content-container">

      {% content_for 'block',
        type: '_blog-post-content',
        id: 'blog-post-content'
      %}

    </div>

  </section>

</article>


{% schema %}
{
  "name": "Main blog post",
  "tag": "section",
  "class": "section-main-blog-post",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "image"
    },
    {
      "type": "_blog-post-content"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "Content direction",
      "options": [
        {
          "value": "column",
          "label": "Column"
        },
        {
          "value": "row",
          "label": "Row"
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2F9E8"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Main blog post"
    }
  ]
}
{% endschema %}