{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

<section
  class="newsletter-section"
  id="newsletter-section-{{ section.id }}"
>
  <div class="newsletter-section__container">

    {% if section.settings.heading != blank %}
      <h2 class="newsletter-section__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="newsletter-section__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.privacy_text != blank %}
      <div class="newsletter-section__privacy">
        {{ section.settings.privacy_text }}
      </div>
    {% endif %}

    {% form 'customer', class: 'newsletter-section__form' %}
      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      <div class="newsletter-section__form-row">

        <input
          type="email"
          name="contact[email]"
          class="newsletter-section__input"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="{{ section.settings.placeholder }}"
          aria-label="{{ section.settings.placeholder }}"
          required
        >

        <button
          type="submit"
          class="newsletter-section__button"
        >
          {{ section.settings.button_text }}
        </button>

      </div>

      {% if form.posted_successfully? %}
        <p class="newsletter-section__message newsletter-section__message--success">
          {{ section.settings.success_message }}
        </p>
      {% endif %}

      {% if form.errors %}
        <div class="newsletter-section__message newsletter-section__message--error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
    {% endform %}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter section",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better decisions, delivered."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Sign up for carefully selected releases, room guidance, and<br>exclusive previews shaped by our design team.</p>"
    },
    {
      "type": "richtext",
      "id": "privacy_text",
      "label": "Privacy text",
      "default": "<p>By subscribing, you agree to our Privacy Policy and consent to receive<br>communications from daals.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter section"
    }
  ]
}
{% endschema %}