      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Logo text",
          "default": "THE TIMES"
        }
      ]
    }
  ],
  "presets": [
    {
