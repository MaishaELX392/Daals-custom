{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>

<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --border-bottom-width: {{ section.settings.divider_width }}px;
    --announcement-background: {{ section.settings.background_color }};
    --announcement-text-color: {{ section.settings.text_color }};
    {% if section.settings.divider_color != blank %}
      --color-border: {{ section.settings.divider_color }};
    {% endif %}
  "
>
  <div class="announcement-bar__slides">

    {% for block in section.blocks %}

      <div
        class="announcement-bar__item"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.link != blank %}
          <a
            href="{{ block.settings.link }}"
            class="announcement-bar__link"
          >
        {% endif %}

        <div class="announcement-bar__content">

          {% if block.settings.icon != blank %}
            <img
              src="{{ block.settings.icon | image_url: width: 100 }}"
              alt="{{ block.settings.icon.alt | escape }}"
              class="announcement-bar__icon"
              width="auto"
              height="auto"
            >
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="announcement-bar__text">
              {{ block.settings.text }}
            </p>
          {% endif %}

        </div>

        {% if block.settings.link != blank %}
          </a>
        {% endif %}

      </div>

    {% endfor %}

  </div>
</aside>


{% schema %}
{
  "name": "Announcement bar",

  "enabled_on": {
    "groups": ["header"]
  },

  "max_blocks": 3,

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery over £99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],

  "settings": [
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#774D43"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#774D43",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],

  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free delivery over £99"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Over 55,000 5-star reviews"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Exclusive daals designs"
          }
        }
      ]
    }
  ]
}
{% endschema %}