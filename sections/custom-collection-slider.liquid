{{ 'custom-collection-slider.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-collection-slider.js' | asset_url }}" defer></script>

<section
  id="CustomCollectionSlider-{{ section.id }}"
  class="custom-collection-slider"
>
  <div class="custom-collection-slider__container">

    <div class="custom-collection-slider__header">

      <div class="custom-collection-slider__heading-wrapper">

        {% if section.settings.heading != blank %}
          <h2 class="custom-collection-slider__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="custom-collection-slider__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>

    </div>

    {% if section.blocks.size > 0 %}

      <div class="custom-collection-slider__wrapper">

        <button
          type="button"
          class="custom-collection-slider__arrow custom-collection-slider__arrow--prev"
          aria-label="Previous products"
          data-slider-prev
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M12.5 15L7.5 10L12.5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="custom-collection-slider__track"
          data-slider-track
        >

          {% for block in section.blocks %}

            {% assign product = block.settings.product %}

            {% if product != blank %}

              <div
                class="custom-collection-slider__item"
                {{ block.shopify_attributes }}
              >
                {% render 'custom-product-card',
                  product: product,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_quick_add: section.settings.show_quick_add
                %}
              </div>

            {% endif %}

          {% endfor %}

        </div>

        <button
          type="button"
          class="custom-collection-slider__arrow custom-collection-slider__arrow--next"
          aria-label="Next products"
          data-slider-next
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M7.5 15L12.5 10L7.5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      </div>

    {% else %}

      <div class="custom-collection-slider__empty">
        <p>Add products to this slider.</p>
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Custom collection slider",
  "tag": "section",
  "class": "custom-collection-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Garden Collections"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom collection slider",
      "category": "Products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}