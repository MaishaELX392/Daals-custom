{% if menu != blank %}
  <div class="header-megamenu-container">
    <nav
      class="header-megamenu"
      aria-label="Main navigation"
    >
      <div class="header-megamenu__inner">
        <ul class="header-megamenu__list" role="list">

          {% for link in menu.links %}
            <li
              class="header-megamenu__item{% if link.links != blank %} header-megamenu__item--has-dropdown{% endif %}"
            >
              <a
                href="{{ link.url }}"
                class="header-megamenu__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span>{{ link.title }}</span>

                {% if link.links != blank %}
                  <svg
                    class="header-megamenu__chevron"
                    width="10"
                    height="6"
                    viewBox="0 0 10 6"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M1 1L5 5L9 1"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                {% endif %}
              </a>

              {% if link.links != blank %}
                <div class="header-megamenu__dropdown">
                  <div class="header-megamenu__dropdown-inner">

                    <ul
                      class="header-megamenu__dropdown-list"
                      role="list"
                    >
                      {% for child_link in link.links %}
                        <li class="header-megamenu__dropdown-item">

                          <a
                            href="{{ child_link.url }}"
                            class="header-megamenu__dropdown-link"
                            {% if child_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ child_link.title }}
                          </a>

                          {% if child_link.links != blank %}
                            <ul
                              class="header-megamenu__sub-list"
                              role="list"
                            >
                              {% for grandchild_link in child_link.links %}
                                <li class="header-megamenu__sub-item">
                                  <a
                                    href="{{ grandchild_link.url }}"
                                    class="header-megamenu__sub-link"
                                    {% if grandchild_link.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ grandchild_link.title }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}

                        </li>
                      {% endfor %}
                    </ul>

                  </div>
                </div>
              {% endif %}

            </li>
          {% endfor %}

        </ul>
      </div>
    </nav>
  </div>
{% endif %}