{{ 'reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-collection-slider.js' | asset_url }}" defer></script>

<section
  class="reviews-section"
  data-slider-section
  style="
    --reviews-background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
  "
>
  <div class="reviews-section__content">

    <div class="reviews-section__header">

      {% if section.settings.heading != blank %}
        <h2 class="reviews-section__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.show_trustpilot %}
        <div class="reviews-section__trustpilot">

          {% if section.settings.trustpilot_text != blank %}
            <span class="reviews-section__trustpilot-text">
              {{ section.settings.trustpilot_text }}
            </span>
          {% endif %}

          <span class="reviews-section__trustpilot-brand">
            <span class="reviews-section__trustpilot-star">
              ★
            </span>

            Trustpilot
          </span>

        </div>
      {% endif %}

    </div>

    {% assign review_blocks = section.blocks | where: 'type', 'review' %}

    {% if review_blocks.size > 0 %}

      <div class="reviews-slider">

        <button
          type="button"
          class="reviews-slider__arrow reviews-slider__arrow--prev"
          data-slider-prev
          aria-label="Previous reviews"
        >
          <span>‹</span>
        </button>

        <div
          class="reviews-slider__track"
          data-slider-track
        >

          {% for block in review_blocks %}

            <article
              class="review-card"
              data-slider-item
              {{ block.shopify_attributes }}
            >

              <div class="review-card__image">

                {% if block.settings.image != blank %}

                  {{
                    block.settings.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 500',
                      sizes: '(max-width: 600px) 105px, 108px'
                  }}

                {% else %}

                  {{ 'image' | placeholder_svg_tag: 'review-card__placeholder' }}

                {% endif %}

              </div>

              <div class="review-card__content">

                <div
                  class="review-card__stars"
                  aria-label="5 out of 5 stars"
                >
                  {% for i in (1..5) %}
                    <span class="review-card__star">
                      ★
                    </span>
                  {% endfor %}
                </div>

                {% if block.settings.title != blank %}
                  <h3 class="review-card__title">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="review-card__text">
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.name != blank %}
                  <p class="review-card__name">
                    {{ block.settings.name }}
                  </p>
                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>

        <button
          type="button"
          class="reviews-slider__arrow reviews-slider__arrow--next"
          data-slider-next
          aria-label="Next reviews"
        >
          <span>›</span>
        </button>

      </div>

    {% endif %}

  </div>

  {% assign logo_blocks = section.blocks | where: 'type', 'logo' %}

  {% if logo_blocks.size > 0 %}

    <div class="reviews-press">

      <div class="reviews-press__inner">

        {% if section.settings.as_seen_in_text != blank %}
          <div class="reviews-press__label">
            {{ section.settings.as_seen_in_text }}
          </div>
        {% endif %}

        <div class="reviews-press__logos">

          {% for block in logo_blocks %}

            <div
              class="reviews-press__logo"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.logo != blank %}

                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '120, 200, 300, 400'
                }}

              {% elsif block.settings.logo_text != blank %}

                <span>
                  {{ block.settings.logo_text }}
                </span>

              {% endif %}

            </div>

          {% endfor %}

        </div>

      </div>

    </div>

  {% endif %}

</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "reviews-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't just take our word"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot",
      "default": true
    },
    {
      "type": "text",
      "id": "trustpilot_text",
      "label": "Trustpilot text",
      "default": "Rated Excellent on"
    },
    {
      "type": "text",
      "id": "as_seen_in_text",
      "label": "Press label",
      "default": "As Seen In:"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
