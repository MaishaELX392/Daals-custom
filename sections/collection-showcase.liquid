{{ 'collection-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-showcase.js' | asset_url }}" defer></script>

<div
  class="section-collection-showcase collection-section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  {% render 'collection-banner',
    banner_image: section.settings.banner_image,
    banner_title: section.settings.banner_title,
    banner_description: section.settings.banner_description,
    read_more_text: section.settings.read_more_text,
    read_less_text: section.settings.read_less_text
  %}

  <div class="page-width">

    <div class="collection-toolbar">

      <div class="collection-toolbar__filters">
        <button
          type="button"
          class="collection-toolbar__btn js-filter-toggle"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>

          Filters
        </button>
      </div>

      <div class="collection-toolbar__product-count">
        Viewing
        {{ paginate.current_offset | plus: 1 }}
        -
        {% if paginate.next %}
          {{ paginate.current_offset | plus: paginate.page_size }}
        {% else %}
          {{ collection.products_count }}
        {% endif %}
        of {{ collection.products_count }} products
      </div>

      <div class="collection-toolbar__sort">
        <div class="sort-by-wrapper">

          <span class="sort-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="6" y1="12" x2="18" y2="12"></line>
              <line x1="10" y1="18" x2="14" y2="18"></line>
            </svg>
          </span>

          <label for="SortBy" class="visually-hidden">
            Sort by
          </label>

          <select
            name="sort_by"
            id="SortBy"
            class="collection-toolbar__sort-select"
          >
            {% for option in collection.sort_options %}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == collection.sort_by %}
                  selected
                {% endif %}
              >
                {{ option.name | escape }}
              </option>
            {% endfor %}
          </select>

        </div>
      </div>

    </div>

    {% paginate collection.products by section.settings.products_per_page %}

      {% if collection.products.size == 0 and section.blocks.size == 0 %}

        <div
          class="collection collection--empty page-width"
          id="main-collection-product-grid"
          data-id="{{ section.id }}"
        >
          <p class="collection-empty-message">
            No products found matching your criteria.
          </p>
        </div>

      {% else %}

        <div
          class="custom-collection-grid"
          data-id="{{ section.id }}"
        >

          {% for block in section.blocks %}
            {% case block.type %}

              {% when 'featured_product' %}

                {% if block.settings.product != blank %}
                  <div
                    class="grid-block-item"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'custom-collection-card',
                      product: block.settings.product
                    %}
                  </div>
                {% endif %}

            {% endcase %}
          {% endfor %}

          {% for product in collection.products %}
            {% render 'custom-collection-card',
              product: product
            %}
          {% endfor %}

        </div>

        {% if paginate.pages > 1 %}
          <div class="collection-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}

      {% endif %}

    {% endpaginate %}

  </div>
</div>

{% schema %}
{
  "name": "Collection Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title",
      "default": "Living Room Furniture",
      "info": "Leave blank to use the default collection title."
    },
    {
      "type": "textarea",
      "id": "banner_description",
      "label": "Banner Description",
      "default": "Your living room, where everyday moments and memorable gatherings unfold. Explore our hand-crafted curated pieces..."
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read More Button Text",
      "default": "READ MORE"
    },
    {
      "type": "text",
      "id": "read_less_text",
      "label": "Read Less Button Text",
      "default": "READ LESS"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Add Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Showcase"
    }
  ]
}
{% endschema %}