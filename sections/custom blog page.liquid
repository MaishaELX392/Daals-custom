{{ 'main-blog-post.css' | asset_url | stylesheet_tag }}

<article class="custom-blog-post">

  <section
    class="custom-blog-post__hero"
    style="
      --article-hero-background: {{ section.settings.background_color }};
      --article-hero-text-color: {{ section.settings.text_color }};
      --article-hero-image-radius: {{ section.settings.image_radius }}px;
      --article-hero-padding-top: {{ section.settings.padding_top }}px;
      --article-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >

    <div class="custom-blog-post__container">

      <div class="custom-blog-post__hero-grid">

        <div class="custom-blog-post__hero-content">

          {% if section.settings.eyebrow != blank %}
            <div class="custom-blog-post__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {% endif %}

          <h1 class="custom-blog-post__title">
            {% if section.settings.title != blank %}
              {{ section.settings.title }}
            {% else %}
              {{ article.title }}
            {% endif %}
          </h1>

          {% if section.settings.description != blank %}

            <div class="custom-blog-post__description">
              {{ section.settings.description }}
            </div>

          {% elsif article.excerpt != blank %}

            <div class="custom-blog-post__description">
              {{ article.excerpt }}
            </div>

          {% endif %}

          {% if section.settings.show_author
            or section.settings.show_date
            or section.settings.show_read_time
          %}

            <div class="custom-blog-post__meta">

              {% if section.settings.show_author %}

                <div class="custom-blog-post__author">

                  {% if section.settings.author_image != blank %}

                    <div class="custom-blog-post__author-image">
                      {{
                        section.settings.author_image
                        | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          widths: '60, 90, 120',
                          sizes: '60px',
                          alt: section.settings.author_name
                      }}
                    </div>

                  {% else %}

                    <div class="custom-blog-post__author-image custom-blog-post__author-placeholder"></div>

                  {% endif %}

                  <div class="custom-blog-post__author-info">

                    {% if section.settings.author_name != blank %}

                      <div class="custom-blog-post__author-name">
                        {{ section.settings.author_name }}
                      </div>

                    {% elsif article.author != blank %}

                      <div class="custom-blog-post__author-name">
                        {{ article.author }}
                      </div>

                    {% endif %}

                    <div class="custom-blog-post__author-details">

                      {% if section.settings.show_date %}

                        {% if section.settings.date_text != blank %}

                          <span>
                            {{ section.settings.date_text }}
                          </span>

                        {% elsif article.published_at != blank %}

                          <span>
                            {{ article.published_at | date: '%B %d, %Y' }}
                          </span>

                        {% endif %}

                      {% endif %}

                      {% if section.settings.show_date
                        and section.settings.show_read_time
                      %}

                        <span class="custom-blog-post__meta-separator">
                          ·
                        </span>

                      {% endif %}

                      {% if section.settings.show_read_time %}

                        {% if section.settings.read_time != blank %}

                          <span>
                            {{ section.settings.read_time }}
                          </span>

                        {% endif %}

                      {% endif %}

                    </div>

                  </div>

                </div>

              {% endif %}

            </div>

          {% endif %}

        </div>

        <div class="custom-blog-post__hero-media">

          {% if section.settings.hero_image != blank %}

            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                class: 'custom-blog-post__hero-image',
                loading: 'eager',
                widths: '600, 800, 1000, 1200, 1400, 1600, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: section.settings.image_alt
            }}

          {% elsif article.image != blank %}

            {{
              article.image
              | image_url: width: 1800
              | image_tag:
                class: 'custom-blog-post__hero-image',
                loading: 'eager',
                widths: '600, 800, 1000, 1200, 1400, 1600, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: article.image.alt | default: article.title
            }}

          {% else %}

            <div class="custom-blog-post__image-placeholder"></div>

          {% endif %}

        </div>

      </div>

    </div>

  </section>


  {% if article.content != blank %}

    <section class="custom-blog-post__content-section">

      <div class="custom-blog-post__content-container">
        {{ article.content }}
      </div>

    </section>

  {% endif %}

</article>


{% schema %}
{
  "name": "Custom Blog Post",
  "tag": "section",
  "class": "section-custom-blog-post",
  "settings": [
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Blog"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "info": "Leave empty to automatically use the article title."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Leave empty to automatically use the article excerpt."
    },
    {
      "type": "header",
      "content": "Author"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "PartyPatch Editorial Team"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author image"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "header",
      "content": "Article information"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "text",
      "id": "date_text",
      "label": "Date",
      "info": "Leave empty to use the article publication date."
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "text",
      "id": "read_time",
      "label": "Reading time",
      "default": "8 min read"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Leave empty to automatically use the article featured image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Article featured image"
    },
    {
      "type": "header",
      "content": "Hero design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2F9E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#202124"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Custom Blog Post"
    }
  ]
}
{% endschema %}