{{ 'benefits-section.css' | asset_url | stylesheet_tag }}

<section
  id="benefits-section-{{ section.id }}"
  class="benefits-section"
>
  <div class="benefits-section__container">
    <div class="benefits-section__grid">

      {% for block in section.blocks %}
        <div
          class="benefits-section__item"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.title != blank %}
            <h3 class="benefits-section__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          <div class="benefits-section__icon">

            {% if block.settings.icon != blank %}

              {{
                block.settings.icon
                | image_url: width: 100
                | image_tag:
                  class: 'benefits-section__icon-image',
                  loading: 'lazy',
                  widths: '50, 75, 100',
                  sizes: '50px',
                  alt: block.settings.title
              }}

            {% else %}

              {% case block.settings.icon_type %}

                {% when 'delivery' %}

                  <svg
                    class="benefits-section__icon-svg"
                    width="42"
                    height="42"
                    viewBox="0 0 42 42"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 10.5H25.5V29H6V10.5Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M25.5 17H31.2L36 22.5V29H25.5V17Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <circle
                      cx="12"
                      cy="30"
                      r="3"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <circle
                      cx="30"
                      cy="30"
                      r="3"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>

                {% when 'payment' %}

                  <svg
                    class="benefits-section__icon-svg"
                    width="42"
                    height="42"
                    viewBox="0 0 42 42"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <rect
                      x="7"
                      y="10"
                      width="28"
                      height="22"
                      rx="3"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M7 16H35"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M27 22H35V28H27C25.3431 28 24 26.6569 24 25C24 23.3431 25.3431 22 27 22Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>

                {% when 'new' %}

                  <svg
                    class="benefits-section__icon-svg"
                    width="42"
                    height="42"
                    viewBox="0 0 42 42"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M21 6L22.8 13.2L30 15L22.8 16.8L21 24L19.2 16.8L12 15L19.2 13.2L21 6Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M31 22L32.1 26.4L36.5 27.5L32.1 28.6L31 33L29.9 28.6L25.5 27.5L29.9 26.4L31 22Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M11 25L11.8 28.2L15 29L11.8 29.8L11 33L10.2 29.8L7 29L10.2 28.2L11 25Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                  </svg>

              {% endcase %}

            {% endif %}

          </div>

          {% if block.settings.description != blank %}
            <div class="benefits-section__description">
              {{ block.settings.description }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits section",
  "tag": "section",
  "class": "section-benefits",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Delivered by daals"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            {
              "value": "delivery",
              "label": "Delivery"
            },
            {
              "value": "payment",
              "label": "Payment"
            },
            {
              "value": "new",
              "label": "New arrivals"
            }
          ],
          "default": "delivery"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon",
          "info": "Upload an icon to replace the default icon."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Free Standard Delivery on orders over £99</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits section",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Delivered by daals",
            "icon_type": "delivery",
            "description": "<p>Free Standard Delivery on orders over £99</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Flexible payment options",
            "icon_type": "payment",
            "description": "<p>Pay in 3 or 4 interest-free instalments with Klarna or Clearpay</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "New Arrivals",
            "icon_type": "new",
            "description": "<p>New styles added regularly. Check our latest exclusive designs</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}