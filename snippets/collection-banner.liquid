<div
  class="custom-collection-banner"
  style="
    --banner-bg:
    {% if banner_image %}
      url('{{ banner_image | image_url: width: 2000 }}')
    {% else %}
      none
    {% endif %};
  "
>

  <div class="custom-collection-banner__overlay"></div>

  <div class="page-width custom-collection-banner__content">

    <h1 class="custom-collection-banner__title">
      {{ banner_title | default: collection.title }}
    </h1>

    {% if banner_description != blank %}

      <div class="custom-collection-banner__description-wrapper">

        <div
          class="custom-collection-banner__description rte"
          id="CollectionDescription-{{ section.id }}"
        >
          {{ banner_description }}
        </div>

        <button
          type="button"
          class="custom-collection-banner__read-more"
          aria-expanded="false"
          aria-controls="CollectionDescription-{{ section.id }}"
        >
          <span class="text-read">
            {{ read_more_text | default: 'READ MORE' }}
          </span>

          <span class="text-less">
            {{ read_less_text | default: 'READ LESS' }}
          </span>
        </button>

      </div>

    {% endif %}

  </div>

</div>