{{ 'custom-collection-slider.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-collection-slider.js' | asset_url }}" defer></script>

<section
  id="CustomCollectionSlider-{{ section.id }}"
  class="custom-collection-slider"
>
  <div class="custom-collection-slider__container">

    <div class="custom-collection-slider__header">

      <div class="custom-collection-slider__heading-wrapper">

        {% if section.settings.heading != blank %}
          <h2 class="custom-collection-slider__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="custom-collection-slider__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>

      {% if section.settings.collection != blank %}
        <a
          href="{{ section.settings.collection.url }}"
          class="custom-collection-slider__view-all"
        >
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}

    </div>

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}

      <div class="custom-collection-slider__wrapper">

        <button
          type="button"
          class="custom-collection-slider__arrow custom-collection-slider__arrow--prev"
          aria-label="Previous products"
          data-slider-prev
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M12.5 15L7.5 10L12.5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="custom-collection-slider__track"
          data-slider-track
        >
          {% for product in selected_collection.products limit: section.settings.products_to_show %}
            <div class="custom-collection-slider__item">
              {% render 'custom-product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                show_quick_add: section.settings.show_quick_add
              %}
            </div>
          {% endfor %}
        </div>

        <button
          type="button"
          class="custom-collection-slider__arrow custom-collection-slider__arrow--next"
          aria-label="Next products"
          data-slider-next
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M7.5 15L12.5 10L7.5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      </div>

    {% else %}

      <div class="custom-collection-slider__empty">
        <p>Select a collection to display products.</p>
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Custom collection slider",
  "tag": "section",
  "class": "custom-collection-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom collection slider",
      "category": "Products"
    }
  ]
}
{% endschema %}