{{ 'featured-promos.css' | asset_url | stylesheet_tag }}

<section
  id="FeaturedPromos-{{ section.id }}"
  class="featured-promos"
>
  <div class="featured-promos__container">
    <div class="featured-promos__grid">
      {% for block in section.blocks %}
        <article
          class="featured-promos__card"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <div class="featured-promos__image-wrapper">
              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="featured-promos__image-link"
                  {% if block.settings.open_in_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                  aria-label="{{ block.settings.heading | escape }}"
                >
              {% endif %}

              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  class: 'featured-promos__image',
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}

          <div class="featured-promos__content">
            {% if block.settings.heading != blank %}
              <h2 class="featured-promos__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="featured-promos__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank %}
              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="featured-promos__button"
                  {% if block.settings.open_in_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ block.settings.button_label }}
                </a>
              {% else %}
                <span class="featured-promos__button">
                  {{ block.settings.button_label }}
                </span>
              {% endif %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured promos",
  "tag": "section",
  "class": "featured-promos-wrapper",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "promo",
      "name": "Promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New Outdoor Furniture"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Browse our latest exclusive designs. Limited availability.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#704B42"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "label": "Content top padding",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "label": "Content bottom padding",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Featured promos",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "heading": "New Outdoor Furniture",
            "description": "<p>Browse our latest exclusive designs. Limited availability.</p>",
            "button_label": "Shop now"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "New Bed Arrivals",
            "description": "<p>Statement luxury, reimagined.</p>",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}