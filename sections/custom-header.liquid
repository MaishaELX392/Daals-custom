{{ 'custom-header.css' | asset_url | stylesheet_tag }}
{{ 'custom-search.css' | asset_url | stylesheet_tag }}
{{ 'header-megamenu.css' | asset_url | stylesheet_tag }}

<script src="{{ 'custom-header.js' | asset_url }}" defer></script>
{% assign header_menu = section.settings.menu %}

{% if header_menu == blank %}
  {% assign header_menu = linklists.main-menu %}
{% endif %}

<header
  class="custom-header"
  style="
    --header-text-color: {{ section.settings.text_color }};
    --header-top-offset: {{ section.settings.top_offset }}px;
    --header-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="custom-header__container">

    <div class="custom-header__main">

      <div class="custom-header__search">
        {% render 'custom-search',
          search_placeholder: section.settings.search_placeholder
        %}
      </div>

      <div class="custom-header__logo">
        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo-link"
          aria-label="{{ shop.name | escape }}"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag:
                class: 'custom-header__logo-image',
                widths: '200,300,400,500',
                loading: 'eager',
                alt: shop.name
            }}
          {% else %}
            <img
              src="https://www.daals.co.uk/cdn/shop/files/New26_daals-logo-master-web.svg?v=1772016725"
              alt="{{ shop.name | escape }}"
              class="custom-header__logo-image"
              width="150"
              height="50"
              loading="eager"
            >
          {% endif %}
        </a>
      </div>

      <div class="custom-header__actions">

        {% if section.settings.phone_number != blank or section.settings.opening_hours != blank %}
          <div class="custom-header__contact">

            {% if section.settings.phone_number != blank %}
              <a
                href="tel:{{ section.settings.phone_number | remove: ' ' }}"
                class="custom-header__phone"
              >
                {{ section.settings.phone_number }}
              </a>
            {% endif %}

            {% if section.settings.opening_hours != blank %}
              <span class="custom-header__hours">
                {{ section.settings.opening_hours }}
              </span>
            {% endif %}

          </div>
        {% endif %}

        <a
          href="{{ section.settings.wishlist_url | default: routes.root_url }}"
          class="custom-header__action custom-header__wishlist"
          aria-label="Wishlist"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="33"
            height="34"
            viewBox="0 0 33 34"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M25.4578 11.0913C24.9691 10.5868 24.3889 10.1866 23.7503 9.91358C23.1117 9.64054 22.4272 9.5 21.7359 9.5C21.0446 9.5 20.3601 9.64054 19.7215 9.91358C19.0829 10.1866 18.5026 10.5868 18.0139 11.0913L16.9997 12.1379L15.9855 11.0913C14.9984 10.0728 13.6596 9.50053 12.2636 9.50053C10.8676 9.50053 9.52879 10.0728 8.54168 11.0913C7.55456 12.1099 7 13.4914 7 14.9319C7 16.3723 7.55456 17.7538 8.54168 18.7724L9.55588 19.8189L16.9997 27.5L24.4436 19.8189L25.4578 18.7724C25.9467 18.2681 26.3346 17.6694 26.5992 17.0105C26.8638 16.3515 27 15.6452 27 14.9319C27 14.2186 26.8638 13.5123 25.4578 11.0913Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a
          href="{{ routes.account_url }}"
          class="custom-header__action custom-header__account"
          aria-label="Account"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="19"
            height="22"
            viewBox="0 0 19 22"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M17.5 20.0625V18C17.5 16.906 17.0654 15.8568 16.2918 15.0832C15.5182 14.3096 14.469 13.875 13.375 13.875H5.125C4.03098 13.875 2.98177 14.3096 2.20818 15.0832C1.4346 15.8568 1 16.906 1 18V20.0625"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M9.25 9.75C11.5282 9.75 13.375 7.90317 13.375 5.625C13.375 3.34683 11.5282 1.5 9.25 1.5C6.97183 1.5 5.125 3.34683 5.125 5.625C5.125 7.90317 6.97183 9.75 9.25 9.75Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a
          href="{{ routes.cart_url }}"
          class="custom-header__cart"
          aria-label="{{ section.settings.cart_text | escape }}"
        >
          <span class="custom-header__cart-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M6 2L3 6V20C3 21.1046 3.89543 22 5 22H19C20.1046 22 21 21.1046 21 20V6L18 2H6Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M3 6H21"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16 10C16 11.0609 15.5784 12.0783 14.8284 12.8284C14.0786 13.5786 13.0609 14 12 14C10.9391 14 9.92157 13.5786 9.17157 12.8284C8.42172 12.0783 8 11.0609 8 10"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <span class="custom-header__cart-text">
            {{ section.settings.cart_text }}
          </span>
        </a>

      </div>

    </div>

    {% render 'header-megamenu',
      menu: header_menu,
      text_color: section.settings.text_color,
      menu_gap: section.settings.menu_gap,
      menu_font_size: section.settings.menu_font_size,
      menu_font_weight: section.settings.menu_font_weight,
      menu_padding_top: section.settings.menu_padding_top,
      menu_padding_bottom: section.settings.menu_padding_bottom,
      dropdown_width: section.settings.dropdown_width
    %}

  </div>
</header>

{% schema %}
{
  "name": "Custom header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "What are you looking for?"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "02477 180 023"
    },
    {
      "type": "text",
      "id": "opening_hours",
      "label": "Opening hours",
      "default": "8:30am - 5.30pm"
    },
    {
      "type": "header",
      "content": "Wishlist"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist link"
    },
    {
      "type": "header",
      "content": "Basket"
    },
    {
      "type": "text",
      "id": "cart_text",
      "label": "Basket text",
      "default": "Basket"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Menu item spacing",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 57
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "menu_font_weight",
      "label": "Menu font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "menu_padding_top",
      "label": "Menu top spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "menu_padding_bottom",
      "label": "Menu bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "dropdown_width",
      "label": "Dropdown width",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text and icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "top_offset",
      "label": "Header top offset",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 42
    }
  ],
  "presets": [
    {
      "name": "Custom header",
      "settings": {
        "logo_width": 150,
        "search_placeholder": "What are you looking for?",
        "phone_number": "02477 180 023",
        "opening_hours": "8:30am - 5.30pm",
        "cart_text": "Basket",
        "menu": "main-menu",
        "menu_gap": 57,
        "menu_font_size": 18,
        "menu_font_weight": "400",
        "menu_padding_top": 12,
        "menu_padding_bottom": 20,
        "dropdown_width": 500,
        "text_color": "#FFFFFF",
        "top_offset": 42
      }
    }
  ]
}
{% endschema %}