{{ 'article-hangover.css' | asset_url | stylesheet_tag }}

<section
  id="ArticleHangover-{{ section.id }}"
  class="article-hangover"
>
  <div class="article-hangover__container">

    <div class="article-hangover__content">

      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'content' %}
            <article
              id="{{ block.settings.anchor_id | handleize }}"
              class="article-hangover__block"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h2 class="article-hangover__heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.content != blank %}
                <div class="article-hangover__text">
                  {{ block.settings.content }}
                </div>
              {% endif %}
            </article>

          {% when 'image' %}
            {% if block.settings.image != blank %}
              <div
                id="{{ block.settings.anchor_id | handleize }}"
                class="article-hangover__image-block"
                {{ block.shopify_attributes }}
              >
                <div class="article-hangover__image-wrapper">
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 65vw, 100vw',
                      class: 'article-hangover__image'
                  }}
                </div>

                {% if block.settings.caption != blank %}
                  <div class="article-hangover__caption">
                    {{ block.settings.caption }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

        {% endcase %}
      {% endfor %}

    </div>

    <aside class="article-hangover__sidebar">

      <div class="article-hangover__sidebar-inner">

        <div class="article-hangover__share">
          <h3 class="article-hangover__sidebar-title">
            {{ section.settings.share_title }}
          </h3>

          <div class="article-hangover__socials">

            <a
              href="https://twitter.com/intent/tweet?url={{ shop.url | url_encode }}"
              class="article-hangover__social"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.26 2.25H8.04l4.713 6.231 5.491-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/>
              </svg>
            </a>

            <a
              href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | url_encode }}"
              class="article-hangover__social"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on Facebook"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M14 8h3V4h-3c-3.314 0-5 1.686-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.667.333-1 1-1Z"/>
              </svg>
            </a>

            <a
              href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url | url_encode }}"
              class="article-hangover__social"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M6.5 8.5A2.5 2.5 0 1 0 6.5 3a2.5 2.5 0 0 0 0 5.5ZM4 10h5v11H4V10Zm7 0h4.8v1.5h.1c.67-1.1 2.3-2.25 4.6-2.25 4.92 0 5.5 3.25 5.5 7.48V21h-5v-3.8c0-.91-.02-2.08-1.27-2.08-1.27 0-1.47.99-1.47 2.01V21h-5V10Z"/>
              </svg>
            </a>

          </div>
        </div>

        <nav class="article-hangover__navigation">

          <button
            type="button"
            class="article-hangover__navigation-header"
            aria-expanded="true"
          >
            <span>
              {{ section.settings.jump_title }}
            </span>

            <svg
              class="article-hangover__chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>

          <div class="article-hangover__navigation-list">

            {% assign navigation_index = 0 %}

            {% for block in section.blocks %}
              {% if block.settings.anchor_id != blank %}

                {% assign navigation_index = navigation_index | plus: 1 %}

                <a
                  href="#{{ block.settings.anchor_id | handleize }}"
                  class="article-hangover__navigation-item"
                >
                  <span class="article-hangover__navigation-number">
                    {{ navigation_index | prepend: '0' | slice: -2, 2 }}
                  </span>

                  <span class="article-hangover__navigation-text">
                    {{ block.settings.navigation_title | default: block.settings.heading }}
                  </span>
                </a>

              {% endif %}
            {% endfor %}

          </div>

        </nav>

      </div>

    </aside>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('ArticleHangover-{{ section.id }}');

    if (!section) {
      return;
    }

    var navigationHeader = section.querySelector(
      '.article-hangover__navigation-header'
    );

    var navigationList = section.querySelector(
      '.article-hangover__navigation-list'
    );

    var navigation = section.querySelector(
      '.article-hangover__navigation'
    );

    if (navigationHeader && navigationList && navigation) {
      navigationHeader.addEventListener('click', function () {
        var expanded =
          navigationHeader.getAttribute('aria-expanded') === 'true';

        navigationHeader.setAttribute(
          'aria-expanded',
          expanded ? 'false' : 'true'
        );

        navigation.classList.toggle(
          'is-collapsed',
          expanded
        );
      });
    }

    var navigationLinks = section.querySelectorAll(
      '.article-hangover__navigation-item'
    );

    navigationLinks.forEach(function (link) {
      link.addEventListener('click', function (event) {
        var targetId = link.getAttribute('href');

        if (!targetId || targetId.charAt(0) !== '#') {
          return;
        }

        var target = section.querySelector(targetId);

        if (!target) {
          return;
        }

        event.preventDefault();

        var headerOffset = 30;

        var targetPosition =
          target.getBoundingClientRect().top +
          window.pageYOffset -
          headerOffset;

        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Article Hangover",
  "tag": "section",
  "class": "section-article-hangover",
  "settings": [
    {
      "type": "text",
      "id": "share_title",
      "label": "Share title",
      "default": "Share This Article"
    },
    {
      "type": "text",
      "id": "jump_title",
      "label": "Jump to section title",
      "default": "Jump to Section"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What Causes a Hangover?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>A hangover is your body's response to the toxic effects of alcohol and its metabolites.</p>"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID",
          "default": "what-causes-a-hangover"
        },
        {
          "type": "text",
          "id": "navigation_title",
          "label": "Sidebar title",
          "default": "What Causes a Hangover?"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID"
        },
        {
          "type": "text",
          "id": "navigation_title",
          "label": "Sidebar title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Hangover",
      "blocks": [
        {
          "type": "content",
          "settings": {
            "heading": "What Causes a Hangover?",
            "anchor_id": "what-causes-a-hangover",
            "navigation_title": "What Causes a Hangover?"
          }
        },
        {
          "type": "content",
          "settings": {
            "heading": "The Science Behind Hangover Patches",
            "anchor_id": "science-behind-hangover-patches",
            "navigation_title": "The Science Behind Hangover Patches"
          }
        },
        {
          "type": "image",
          "settings": {
            "anchor_id": "hangover-patch-image",
            "navigation_title": "How to Use PartyPatch for Best Results"
          }
        },
        {
          "type": "content",
          "settings": {
            "heading": "Key Ingredients That Actually Work",
            "anchor_id": "key-ingredients",
            "navigation_title": "Key Ingredients That Actually Work"
          }
        },
        {
          "type": "content",
          "settings": {
            "heading": "Reviews From Real Customers",
            "anchor_id": "reviews",
            "navigation_title": "Reviews From Real Customers"
          }
        },
        {
          "type": "content",
          "settings": {
            "heading": "Frequently Asked Questions",
            "anchor_id": "faq",
            "navigation_title": "Frequently Asked Questions"
          }
        }
      ]
    }
  ]
}
{% endschema %}